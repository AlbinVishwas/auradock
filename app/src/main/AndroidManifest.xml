<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets crash reporting see whether the phone is online (it keeps reports and sends them when it is). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Weather: approximate location only (about a city block), never precise. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Only asked when the user adds a person who can always reach them (read) or switches on ring-through (write). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Task reminders: show notifications (Android 13+), fire at the exact minute (Android 12+, user-granted),
         and set the alarms again after a restart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Focus while docked: lets AuraDock appear in the system's "Do Not Disturb access" list; the user grants it there. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Dock from anywhere" (optional, off by default): a foreground service watches the motion sensor, and a small pill is
         drawn over other apps. The user allows "Display over other apps" in system settings. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Lets AuraDock list the apps that have a launcher icon (for choosing which apps' notifications to show on the dock),
         without the restricted QUERY_ALL_PACKAGES permission. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AuraDockApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="AuraDock"
        android:supportsRtl="true"
        android:theme="@style/Theme.AuraDock">

        <!-- The profile installer's adb-triggered receiver is exported (guarded by DUMP); nothing here needs it. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- Sentry is started by hand in AuraDockApplication (it is off in debug builds and when the owner turns it off). -->
        <meta-data android:name="io.sentry.auto-init" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Woken by AlarmManager when a task is due. Not exported: only AuraDock's own alarms can reach it. -->
        <receiver
            android:name=".tasks.reminders.TaskAlarmReceiver"
            android:exported="false" />

        <!-- Sets alarms again after a restart, an app update, or the exact-alarm permission being granted. -->
        <receiver
            android:name=".tasks.reminders.TaskBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The screensaver ("Daydream"). The system binds to it; BIND_DREAM_SERVICE keeps other apps from doing so. -->
        <service
            android:name=".dock.DockDreamService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="AuraDock"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- "Dock from anywhere": watches the accelerometer while the screen is on. No standard foreground type fits, so specialUse. -->
        <service
            android:name=".watch.DockWatcherService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Reads the accelerometer while the screen is on to notice the phone being set on a stand, then offers AuraDock's dock mode" />
        </service>

        <service
            android:name=".service.AuraNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
