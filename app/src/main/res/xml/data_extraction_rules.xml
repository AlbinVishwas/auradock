<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: what goes to Google's cloud backup and to a phone-to-phone transfer. Same list for both.
     Backed up: tasks (in the database), settings (not the VIP list, which is in auradock_vips), template choice, colour preset, extra cities, stacks.
     Never: DND and VIP restore state, the weather cache, the event log, the monitoring flag, Sentry's cache.
     Focus sessions, their checkpoint, the intention and the event log live in auradock_local.db, which is not listed, so it is never
     backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="auradock.db" />
        <include domain="database" path="auradock.db-wal" />
        <include domain="database" path="auradock.db-shm" />
        <include domain="sharedpref" path="auradock_prefs.xml" />
        <include domain="sharedpref" path="auradock_split.xml" />
        <include domain="sharedpref" path="auradock_focus_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="auradock.db" />
        <include domain="database" path="auradock.db-wal" />
        <include domain="database" path="auradock.db-shm" />
        <include domain="sharedpref" path="auradock_prefs.xml" />
        <include domain="sharedpref" path="auradock_split.xml" />
        <include domain="sharedpref" path="auradock_focus_settings.xml" />
    </device-transfer>
</data-extraction-rules>
