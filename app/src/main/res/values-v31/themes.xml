<resources>
    <!-- Android 12+ splash screen: the mark on pure black. The launcher foreground already sits inside the splash's circular safe zone. -->
    <style name="Theme.AuraDock" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
</resources>
